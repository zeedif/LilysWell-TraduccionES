l}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Échale un vistazo a esto, Lily."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]..."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Échale."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]\\{Un."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]\\{\\{Vistazo."]},{"code":205,"indent":0,"parameters":[-1,{"list":[{"code":16,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":16,"indent":null}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]¡Ah...!"]},{"code":205,"indent":0,"parameters":[2,{"list":[{"code":16,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":false}]},{"code":505,"indent":0,"parameters":[{"code":16,"indent":null}]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Buena chica."]},{"code":223,"indent":0,"parameters":[[-255,-255,-255,0],1,false]},{"code":231,"indent":0,"parameters":[1,"LilyCloneTub",0,0,0,0,100,100,255,0]},{"code":241,"indent":0,"parameters":[{"name":"Horror","volume":90,"pitch":50,"pan":0}]},{"code":230,"indent":0,"parameters":[120]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]¿Pa... pá...?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]¿Qué es...?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Es tu siguiente iteración, Lily."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]¿Iter...?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Me ha tomado años, pero al fin he logrado recrear tu cuerpo."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Lamento no haber acertado con el color del pelo, pero eso pasa cuando se trabaja con el azoth."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Solo hay que arreglar tu alma. Es irremediable que esté algo subdesarrollada."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Siempre me prometes que vas a ser buena chica, pero siempre rompes las reglas de un modo u otro."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Tu primera iteración se cayó por el pozo."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Me vio arrojar un pedido y se pensó que alguien necesitaba ayuda."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]La muy imbécil ni se coscó de que el cuerpo ya había muerto."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Ni siquiera hizo caso de lo que le dijo su papá, que no saliera sola de noche."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Intentó hacer lo mismo que tú. Se hizo una cuerdecilla."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]La cuerda se rompió, pero la iteración no murió al instante."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Entre sus gritos de auxilio, me percaté de algo."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Si eres una niña mala, acabamos contigo, depositamos tu alma en otra iteración y...¡como nueva!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Tu cerebro no recordará nada malo, ¡pero tu alma sabrá que ser una niña mala sólo atrae desgracias!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]¡Algún día, te convertirás en la Lily más ideal que pueda haber sin que tu cerebro se vea dañado por el trauma!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Grabé los gritos de la primera Lily junto a mis ayudantes y decidí comenzar el experimento."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]La verdad es que me pregunté: \\!¿Cuántas veces tendrá que morirse para ver que desobedecer a papá solo conlleva desgracias?"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Lo llamamos Desarrollo Iterativo Genealógico."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Cada nueva generación de Lilys se vuelve más y más lista."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Carne nos sobra, así que podemos seguir desarrollando cuerpos."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]Pero... Pero pensé que... Pensé que alguien necesitaba ayuda..."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Y dale que te pego. Sigues pensando que una voz que llega del exterior es más importante que papá."]},{"code":108,"indent":0,"parameters":["Papá saca su pistola"]},{"code":231,"indent":0,"parameters":[1,"TonyGun",0,0,0,0,100,100,255,0]},{"code":230,"indent":0,"parameters":[60]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]¡¿Papá?!"]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Veamos si con esto aprendes a taparte los oídos y quedarte quietecita esperando a que vuelva papá."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Lily>\\c[5]¡E-espera! ¡Papá, perdón! ¡Seré buena! ¡No me-\\^"]},{"code":241,"indent":0,"parameters":[{"name":"","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":0,"parameters":[1,"TonyShoot",0,0,0,0,100,100,255,0]},{"code":250,"indent":0,"parameters":[{"name":"Gun1","volume":100,"pitch":100,"pan":0}]},{"code":230,"indent":0,"parameters":[30]},{"code":235,"indent":0,"parameters":[1]},{"code":230,"indent":0,"parameters":[300]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]Aun así... he de admitir que papá está muy orgulloso de que te las hayas ingeniado para bajar hasta aquí."]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["\\n<Papá>\\c[1]¿Sabes? Te haré mi aprendiz cuando aprendas a comportarte, ¿vale?"]},{"code":230,"indent":0,"parameters":[60]},{"code":250,"indent":0,"parameters":[{"name":"CancelSound","volume":100,"pitch":50,"pan":0}]},{"code":231,"indent":0,"parameters":[1,"DeadEnd1",0,0,0,0,100,100,255,0]},{"code":230,"indent":0,"parameters":[30]},{"code":250,"indent":0,"parameters":[{"name":"CancelSound","volume":100,"pitch":50,"pan":0}]},{"code":231,"indent":0,"parameters":[1,"DeadEnd2",0,0,0,0,100,100,255,0]},{"code":355,"indent":0,"parameters":["OrangeGreenworks.activateAchievement('Rope10');"]},{"code":230,"indent":0,"parameters":[500]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":["[XXX-XXX-XX1X]"]},{"code":121,"indent":0,"parameters":[44,44,1]},{"code":121,"indent":0,"parameters":[73,73,0]},{"code":117,"indent":0,"parameters":[17]},{"code":0,"indent":0,"parameters":[]}],"move